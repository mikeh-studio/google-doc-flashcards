OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
REQUIRE_LLM=false
GOOGLE_OAUTH_ACCESS_TOKEN=
# Alternative to pasting a token: run `python3 flashcards_cli.py google-auth --run`
# once, then set this to gcloud so the app can request fresh short-lived tokens.
GOOGLE_AUTH_PROVIDER=
# Optional overrides for the gcloud token bridge.
GCLOUD_BIN=gcloud
# Seconds to wait for the browser sign-in started from the web UI Connect button.
GCLOUD_LOGIN_TIMEOUT=300
GOOGLE_AUTH_SCOPES=https://www.googleapis.com/auth/presentations,https://www.googleapis.com/auth/drive.file,https://www.googleapis.com/auth/drive.readonly
HOST=127.0.0.1
PORT=8765
# Set a shared passcode to require sign-in. Leave blank for open localhost-only use.
# Required before binding HOST=0.0.0.0 for mobile/Tailscale access.
APP_PASSCODE=
# Optional: rotate/revoke all issued sign-in cookies without changing the passcode.
APP_AUTH_SECRET=
# Optional: days a sign-in cookie stays valid before re-login is required (default 30).
APP_AUTH_TTL_DAYS=30
# Set to 1 when serving over HTTPS (Tailscale Serve / TLS proxy) to mark the cookie Secure.
APP_COOKIE_SECURE=
